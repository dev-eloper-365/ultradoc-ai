ENV=development
FRONTEND_URL=http://localhost:3000

# LLM — one OpenAI-compatible client. Default is Groq; swap to any hosted
# Ollama server exposing an /v1 endpoint by changing these three values.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Embeddings run locally via fastembed — no cloud key needed.
EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en
MODEL_CACHE_DIR=data/models

DATA_DIR=data
MAX_UPLOAD_MB=10

LOG_LEVEL=INFO
LOG_FORMAT=console
