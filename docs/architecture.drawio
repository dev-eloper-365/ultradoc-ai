<mxfile host="app.diagrams.net" agent="UltraDoc AI README" version="24.7.17">
  <diagram name="Deployment Architecture" id="ultradoc-deploy-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Browser -->
        <mxCell id="browser" value="Browser (user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- GitHub -->
        <mxCell id="github" value="GitHub&#10;dev-eloper-365/ultradoc-ai&#10;(master branch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Vercel -->
        <mxCell id="vercel" value="Vercel&#10;Next.js frontend (apps/web)&#10;NEXT_PUBLIC_API_BASE_URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="60" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- Render container -->
        <mxCell id="render_group" value="Render (free tier, 512MB)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="260" width="320" height="260" as="geometry" />
        </mxCell>

        <mxCell id="render_api" value="FastAPI backend&#10;(Docker, apps/api)&#10;FRONTEND_URL for CORS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="chroma" value="Chroma vector store&#10;(ephemeral — no disk&#10;on free plan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="380" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="models" value="fastembed models&#10;all-MiniLM-L6-v2 +&#10;ms-marco-MiniLM-L-6-v2&#10;(~170MB, baked into image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="550" y="380" width="130" height="70" as="geometry" />
        </mxCell>

        <!-- Groq -->
        <mxCell id="groq" value="Groq API&#10;llama-3.3-70b-versatile&#10;(OpenAI-compatible)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="780" y="290" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_browser_vercel" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="browser" target="vercel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_github_vercel" value="git push&#10;Root Directory: apps/web" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="github" target="vercel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_github_render" value="git push&#10;Docker build, context: apps/api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="github" target="render_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_vercel_render" value="HTTPS + CORS&#10;(FRONTEND_URL allowlist)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="vercel" target="render_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_render_groq" value="chat completions&#10;(LLM_API_KEY)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="render_api" target="groq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Model Switch (Before vs After)" id="ultradoc-model-switch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Before group -->
        <mxCell id="before_group" value="First choice — deployed, then OOM'd on Render free tier" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="360" height="300" as="geometry" />
        </mxCell>

        <mxCell id="old_embed" value="mxbai-embed-large-v1&#10;1024-dim embeddings&#10;1.2 GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="old_rerank" value="jina-reranker-v1-turbo-en&#10;cross-encoder rerank&#10;156 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="old_total" value="= 1.36 GB of model weights on a 512MB container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- After group -->
        <mxCell id="after_group" value="Switched to — fits the free tier" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="360" height="300" as="geometry" />
        </mxCell>

        <mxCell id="new_embed" value="all-MiniLM-L6-v2&#10;384-dim embeddings&#10;90 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="new_rerank" value="ms-marco-MiniLM-L-6-v2&#10;cross-encoder rerank&#10;80 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="190" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="new_total" value="= 170 MB of model weights — same two-stage design kept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="270" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- Transition arrow -->
        <mxCell id="e_switch" value="512MB RAM limit hit —&#10;/upload 502'd every time&#10;(health check passed,&#10;models never loaded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeWidth=2;dashed=1;" edge="1" parent="1" source="old_total" target="after_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
